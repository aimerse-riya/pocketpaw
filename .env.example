# PocketPaw Configuration Example
# Copy this to .env and fill in your API keys

# Required: Anthropic API Key (get from https://console.anthropic.com/)
POCKETCLAW_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Other API keys for additional features
# POCKETCLAW_OPENAI_API_KEY=sk-your-openai-key
# POCKETCLAW_TAVILY_API_KEY=tvly-your-tavily-key
# POCKETCLAW_GOOGLE_API_KEY=your-google-key

# Agent Backend (default: claude_agent_sdk)
# Options: claude_agent_sdk, pocketpaw_native, open_interpreter
POCKETCLAW_AGENT_BACKEND=claude_agent_sdk

# Memory Backend (default: file)
# Options: file, mem0
POCKETCLAW_MEMORY_BACKEND=file

# Tool Profile (default: full)
# Options: minimal, coding, full
POCKETCLAW_TOOL_PROFILE=full

# Security Features
POCKETCLAW_INJECTION_SCAN_ENABLED=true
POCKETCLAW_PLAN_MODE=false
